#include <stdio.h>
#include <string.h>

struct file {
    char fname[20];
};

int main() {
    int n, i, choice, searchFlag = 0;
    struct file f[50];
    char search[20];

    printf("Single Level Directory\n");

    printf("Enter number of files: ");
    scanf("%d", &n);

    // Create files
    for(i = 0; i < n; i++) {
        printf("Enter file %d name: ", i + 1);
        scanf("%s", f[i].fname);
    }

    while(1) {
        printf("\n1. Display Files\n");
        printf("2. Search File\n");
        printf("3. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice) {

            case 1:
                printf("\nFiles in Directory:\n");
                for(i = 0; i < n; i++) {
                    printf("%s\n", f[i].fname);
                }
                break;

            case 2:
                printf("Enter file name to search: ");
                scanf("%s", search);

                searchFlag = 0;

                for(i = 0; i < n; i++) {
                    if(strcmp(search, f[i].fname) == 0) {
                        printf("File found\n");
                        searchFlag = 1;
                        break;
                    }
                }

                if(searchFlag == 0)
                    printf("File not found\n");

                break;

            case 3:
                return 0;

            default:
                printf("Invalid choice\n");
        }
    }

    return 0;
}
