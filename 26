// File Management Operations in C

#include <stdio.h>
#include <stdlib.h>

int main()
{
    FILE *fp;
    char data[100], ch;

    // Create and Write to File
    fp = fopen("file.txt", "w");

    if(fp == NULL)
    {
        printf("File cannot be opened.\n");
        return 1;
    }

    printf("Enter text to write into file: ");
    scanf("%s", data);

    fprintf(fp, "%s", data);
    fclose(fp);

    printf("Data written successfully.\n");

    // Read from File
    fp = fopen("file.txt", "r");

    if(fp == NULL)
    {
        printf("File cannot be opened.\n");
        return 1;
    }

    printf("\nFile Content:\n");

    while((ch = fgetc(fp)) != EOF)
    {
        printf("%c", ch);
    }

    fclose(fp);

    // Append to File
    fp = fopen("file.txt", "a");

    printf("\n\nEnter text to append: ");
    scanf("%s", data);

    fprintf(fp, " %s", data);

    fclose(fp);

    printf("Data appended successfully.\n");

    return 0;
}
