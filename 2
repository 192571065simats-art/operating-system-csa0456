#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main() {
    int source, dest, n;
    char buffer[100];

    // Open source file
    source = open("source.txt", O_RDONLY);

    // Create destination file
    dest = open("destination.txt", O_WRONLY | O_CREAT, 0644);

    // Copy file content
    while ((n = read(source, buffer, sizeof(buffer))) > 0) {
        write(dest, buffer, n);
    }

    printf("File copied successfully\n");

    close(source);
    close(dest);

    return 0;
}
