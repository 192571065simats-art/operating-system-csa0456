#include <stdio.h>

int main() {
    int n, i, time = 0, completed = 0;
    int bt[20], rt[20], pr[20], wt[20], tat[20];
    int smallest, finish_time;
    float avg_wt = 0, avg_tat = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    // Input burst time and priority
    for(i = 0; i < n; i++) {
        printf("Enter Burst Time for P%d: ", i + 1);
        scanf("%d", &bt[i]);

        printf("Enter Priority for P%d: ", i + 1);
        scanf("%d", &pr[i]);

        rt[i] = bt[i];
    }

    // Preemptive Priority Scheduling
    while(completed != n) {
        smallest = -1;

        for(i = 0; i < n; i++) {
            if(rt[i] > 0) {
                if(smallest == -1 || pr[i] < pr[smallest]) {
                    smallest = i;
                }
            }
        }

        rt[smallest]--;
        time++;

        // Process completed
        if(rt[smallest] == 0) {
            completed++;
            finish_time = time;

            wt[smallest] = finish_time - bt[smallest];
            tat[smallest] = wt[smallest] + bt[smallest];

            avg_wt += wt[smallest];
            avg_tat += tat[smallest];
        }
    }

    // Display output
    printf("\nProcess\tPriority\tBurst Time\tWaiting Time\tTurnaround Time\n");

    for(i = 0; i < n; i++) {
        printf("P%d\t%d\t\t%d\t\t%d\t\t%d\n",
               i + 1, pr[i], bt[i], wt[i], tat[i]);
    }

    printf("\nAverage Waiting Time = %.2f", avg_wt / n);
    printf("\nAverage Turnaround Time = %.2f\n", avg_tat / n);

    return 0;
}
