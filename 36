// Linked File Allocation Strategy

#include <stdio.h>

struct Block
{
    int blockNo;
    int next;
};

int main()
{
    struct Block file[20];
    int n, i;

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    // Input block numbers
    for(i = 0; i < n; i++)
    {
        printf("Enter block number %d: ", i + 1);
        scanf("%d", &file[i].blockNo);

        // Link to next block
        if(i < n - 1)
            file[i].next = i + 1;
        else
            file[i].next = -1;
    }

    // Display linked allocation
    printf("\nLinked File Allocation\n");

    for(i = 0; i < n; i++)
    {
        printf("Block %d -> ", file[i].blockNo);

        if(file[i].next != -1)
            printf("Block %d\n", file[file[i].next].blockNo);
        else
            printf("NULL\n");
    }

    return 0;
}
