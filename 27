// Simulating ls UNIX Command in C

#include <stdio.h>
#include <dirent.h>

int main()
{
    DIR *dir;
    struct dirent *entry;

    // Open current directory
    dir = opendir(".");

    if(dir == NULL)
    {
        printf("Cannot open directory.\n");
        return 1;
    }

    printf("Files in current directory:\n\n");

    // Read directory contents
    while((entry = readdir(dir)) != NULL)
    {
        printf("%s\n", entry->d_name);
    }

    // Close directory
    closedir(dir);

    return 0;
}
