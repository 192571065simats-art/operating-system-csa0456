// FIFO Page Replacement Algorithm

#include <stdio.h>

int main()
{
    int pages[50], frames[10];
    int n, f, i, j, k = 0, flag, pageFault = 0;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter page reference string:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &pages[i]);
    }

    printf("Enter number of frames: ");
    scanf("%d", &f);

    // Initialize frames
    for(i = 0; i < f; i++)
    {
        frames[i] = -1;
    }

    printf("\nPage\tFrames\n");

    for(i = 0; i < n; i++)
    {
        flag = 0;

        // Check page hit
        for(j = 0; j < f; j++)
        {
            if(frames[j] == pages[i])
            {
                flag = 1;
                break;
            }
        }

        // Page fault
        if(flag == 0)
        {
            frames[k] = pages[i];
            k = (k + 1) % f;
            pageFault++;
        }

        printf("%d\t", pages[i]);

        for(j = 0; j < f; j++)
        {
            if(frames[j] != -1)
                printf("%d ", frames[j]);
            else
                printf("- ");
        }

        printf("\n");
    }

    printf("\nTotal Page Faults = %d\n", pageFault);

    return 0;
}
