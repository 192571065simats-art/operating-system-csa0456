#include <stdio.h>

int main() {
    int n, i, time = 0, remain, tq;
    int bt[20], rt[20], wt[20], tat[20];
    float avg_wt = 0, avg_tat = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    remain = n;

    // Input burst time
    for(i = 0; i < n; i++) {
        printf("Enter Burst Time for P%d: ", i + 1);
        scanf("%d", &bt[i]);

        rt[i] = bt[i];
    }

    printf("Enter Time Quantum: ");
    scanf("%d", &tq);

    i = 0;

    // Round Robin Scheduling
    while(remain > 0) {

        if(rt[i] <= tq && rt[i] > 0) {
            time += rt[i];
            rt[i] = 0;
        }
        else if(rt[i] > 0) {
            rt[i] -= tq;
            time += tq;
        }

        // Process completed
        if(rt[i] == 0 && bt[i] != 0) {
            remain--;

            wt[i] = time - bt[i];
            tat[i] = time;

            avg_wt += wt[i];
            avg_tat += tat[i];

            bt[i] = 0;
        }

        i = (i + 1) % n;
    }

    // Display output
    printf("\nProcess\tWaiting Time\tTurnaround Time\n");

    for(i = 0; i < n; i++) {
        printf("P%d\t%d\t\t%d\n",
               i + 1, wt[i], tat[i]);
    }

    printf("\nAverage Waiting Time = %.2f", avg_wt / n);
    printf("\nAverage Turnaround Time = %.2f\n", avg_tat / n);

    return 0;
}
